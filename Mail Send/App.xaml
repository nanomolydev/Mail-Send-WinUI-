<Application
    x:Class="Mail_Send.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="using:Mail_Send"
    
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">

    <Application.Resources>

        

        <ResourceDictionary>
            <Color x:Key="SystemAccentColor">#f4a232</Color>
            <Color x:Key="SliderThumbBackground">#f4a232</Color>
            <Color x:Key="SliderThumbBackgroundPointerOver">#f4a232</Color>
            <Color x:Key="SliderThumbBackgroundPressed">#f4a232</Color>

            <Color x:Key="SliderTrackValueFill">#f4a232</Color>
            <Color x:Key="SliderTrackValueFillPointerOver">#f4a232</Color>
            <Color x:Key="SliderTrackValueFillPressed">#f4a232</Color>
            <Color x:Key="SliderTrackValueFillDisabled">#f4a232</Color>

            <Color x:Key="CheckBoxCheckBackgroundFillChecked">#f4a232</Color>
            <Color x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver">#f4a232</Color>
            <Color x:Key="CheckBoxCheckBackgroundFillCheckedPressed">#f4a232</Color>
            <Color x:Key="CheckBoxCheckBackgroundFillCheckedDisabled">#f4a232</Color>

            <Color x:Key="ToggleSwitchFillOn">#f4a232</Color>
