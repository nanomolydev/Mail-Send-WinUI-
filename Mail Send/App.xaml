            <Color x:Key="SystemAccentColorLight1">#f4a232</Color>
            <Color x:Key="SystemColorHighlightColor">#f4a232</Color>
            <Color x:Key="SystemControlHighlightAccentBrush">#f4a232</Color>
            <Color x:Key="SystemControlBackgroundAccentBrush">#f4a232</Color>
            <Color x:Key="SystemControlDisabledAccentBrush">#f4a232</Color>
            <Color x:Key="SystemControlHighlightAltAccentBrush">#f4a232</Color>

            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="/Styles/arlycbrush.xaml" />
                <ResourceDictionary Source="/Styles/FontSizes.xaml" />
                <ResourceDictionary Source="/Styles/Thickness.xaml" />
                <ResourceDictionary Source="/Styles/TextBlock.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        
    </Application.Resources>
    
