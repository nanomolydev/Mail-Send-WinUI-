<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Mail_Send.setting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mail_Send"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"

    xmlns:views="using:Mail_Send.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.DataContext>
        <views:localizated x:Name="ViewModel" />
    </Page.DataContext>
    <Page.Resources>
        <Style x:Key="MySliderThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="#F4A232"/>
            <!-- Другие свойства и стили -->
        </Style>


        <Style x:Key="DraggableListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Иконки для перетаскивания -->
                                <StackPanel Grid.Column="0" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Left" 
                                    VerticalAlignment="Center"
                                    Margin="12,0,12,0">
                                    <Grid Width="20" Height="20">
                                        <Ellipse Fill="#808080" Width="4" Height="4" Margin="0,1,4,1" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <Ellipse Fill="#808080" Width="4" Height="4" Margin="0,1,4,1" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                        <Ellipse Fill="#808080" Width="4" Height="4" Margin="0,1,0,1" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                        <Ellipse Fill="#808080" Width="4" Height="4" Margin="0,1,0,1" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                        <Ellipse Fill="#808080" Width="4" Height="4" Margin="4,1,0,1" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                        <Ellipse Fill="#808080" Width="4" Height="4" Margin="4,1,0,1" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Содержимое ListViewItem -->
                                <ContentPresenter Grid.Column="1" 
                                          Content="{TemplateBinding Content}" 
                                          ContentTemplate="{TemplateBinding ContentTemplate}" 
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                          HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>








        <CollectionViewSource x:Key="manual_list"/>
        <CollectionViewSource x:Key="automatic_list"/>
    </Page.Resources>
    <SplitView IsPaneOpen="True" Name="main_split">
        <SplitView.Pane >
            <Grid Margin="0,50,0,0" CornerRadius="10" BorderThickness="2">
                <Grid.BorderBrush>
                    <SolidColorBrush Color="Black" Opacity="0.2"></SolidColorBrush>
                </Grid.BorderBrush>
                <ListView SelectionChanged="setting_catalog_SelectionChanged" Name="setting_catalog" >
                    <ListViewItem Name="app" >
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xECAA;"></FontIcon>
                            <TextBlock Text="{x:Bind ViewModel.GetString('app_setting'), Mode=OneWay}"></TextBlock>
                        </StackPanel>

                    </ListViewItem>
                    <ListViewItem Name="server" >
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xEDB3;"></FontIcon>
                            <TextBlock Text="{x:Bind ViewModel.GetString('server'), Mode=OneWay}"></TextBlock>
                        </StackPanel>

                    </ListViewItem>
                    <ListViewItem  Name="conf">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE80F;"></FontIcon>
                            <TextBlock Text="{x:Bind ViewModel.GetString('config'), Mode=OneWay}"></TextBlock>
                        </StackPanel>

                    </ListViewItem>

                </ListView>
            </Grid>
        </SplitView.Pane>
        <Grid>
            <Grid Visibility="Collapsed" Name="smtp_grid">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,50,0,0" HorizontalAlignment="Center" Spacing="50">
                    <StackPanel Orientation="Vertical" Width="350" BorderThickness="2">
                        <StackPanel.BorderBrush>
                            <SolidColorBrush Color="Gray" Opacity="0.3"></SolidColorBrush>
                        </StackPanel.BorderBrush>
                        <CheckBox Name="enable_user_smtp" HorizontalAlignment="Left" Checked="enable_user_smtp_Checked" Margin="10" VerticalAlignment="Top"></CheckBox>
                        <TextBlock Margin="0,0,10,0" HorizontalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}">Custom SMTP</TextBlock>
                        <TextBox Margin="10,10,10,0" PlaceholderText="SMTP server (HOST)" TextChanged="smtp_server_TextChanged" Name="smtp_server"></TextBox>
                        <TextBox Margin="10,10,10,10" PlaceholderText="SMTP port (SSL \ TLS) " Name="smtp_port" TextChanged="smtp_port_TextChanged"></TextBox>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Width="300" BorderThickness="2">
                        <StackPanel.BorderBrush>
                            <SolidColorBrush Color="Gray" Opacity="0.3"></SolidColorBrush>
                        </StackPanel.BorderBrush>
                        <CheckBox Name="enable_default_smtp" HorizontalAlignment="Left" Checked="enable_default_smtp_Checked" Margin="10" VerticalAlignment="Top"></CheckBox>
                        <TextBlock Margin="10" HorizontalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}">Default SMTP</TextBlock>
                        <TextBlock Margin="10" HorizontalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}">(GMAIL)</TextBlock>
                        <TextBlock Margin="10" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}">100 email / 1 account in daly</TextBlock>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Grid Visibility="Collapsed" Name="app_grid">
                <Button Click="open_pane_Click" Name="open_pane" VerticalAlignment="Top" Margin="0,50,0,0">
                    <FontIcon Glyph="&#xE76C;"></FontIcon>
                </Button>
                <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="0,50,0,0" HorizontalAlignment="Center" Spacing="10" >
                    <StackPanel Spacing="10" Width="300" HorizontalAlignment="Center" BorderThickness="2" CornerRadius="3">
                        <StackPanel.BorderBrush>
                            <SolidColorBrush Color="Gray" Opacity="0.3"></SolidColorBrush>
                        </StackPanel.BorderBrush>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0" Name="now_version">Test</TextBlock>
                        <Button Name="check_update" Click="check_update_Click" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,10" Content="{x:Bind ViewModel.GetString('update_button'), Mode=OneWay}"></Button>
                        <ProgressBar Name="progressBar" Height="10" VerticalAlignment="Center">

                        </ProgressBar>
                        <TextBlock Name="text_download" Text="Text Download" Margin="0,0,0,10" HorizontalAlignment="Center"></TextBlock>
                    </StackPanel>
                    <StackPanel Width="300" HorizontalAlignment="Center" BorderThickness="2" CornerRadius="3" Spacing="10">
                        <StackPanel.BorderBrush>
                            <SolidColorBrush Color="Gray" Opacity="0.3"></SolidColorBrush>
                        </StackPanel.BorderBrush>
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" Text="{x:Bind ViewModel.GetString('select_language'), Mode=OneWay}"></TextBlock>
                        <ComboBox Margin="0,0,0,10" Name="language_combobox" VerticalAlignment="Center" HorizontalAlignment="Center" SelectionChanged="language_select_SelectionChanged">
                            <ComboBoxItem Name="ru" Content="{x:Bind ViewModel.GetString('ru'), Mode=OneWay}"></ComboBoxItem>
                            <ComboBoxItem Name="en" Content="{x:Bind ViewModel.GetString('en'), Mode=OneWay}"></ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Width="300" Orientation="Vertical" HorizontalAlignment="Center" BorderThickness="2" CornerRadius="3" Margin="0,0,0,0" Spacing="10">
                        <StackPanel.BorderBrush>
                            <SolidColorBrush Color="Gray" Opacity="0.3"></SolidColorBrush>
                        </StackPanel.BorderBrush>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="28 epx" Text="{x:Bind ViewModel.GetString('get_deviceid'), Mode=OneWay}"></TextBlock>
                        <Button Name="copy_deviceid" Margin="0,0,0,10" Click="copy_deviceid_Click" HorizontalAlignment="Center" Content="{x:Bind ViewModel.GetString('copy_deviceid'), Mode=OneWay}"></Button>
                    </StackPanel>
                </StackPanel>

            </Grid>

            <Grid Visibility="Collapsed" Name="deviceid_grid" >
                
                
            </Grid>
            <Grid Visibility="Collapsed" Name="config_grid" Loaded="config_grid_Loaded">

                <Button Click="open_pane_Click" Name="open_pane_config" VerticalAlignment="Top" Margin="0,50,0,0">
                    <FontIcon Glyph="&#xE76C;"></FontIcon>
                </Button>
                <StackPanel Spacing="5" Margin="0,100,0,0">
                    <Grid Width="300" HorizontalAlignment="Center" BorderThickness="2" Height="100" CornerRadius="3">
                        <Grid.BorderBrush>
                            <SolidColorBrush Color="Gray" Opacity="0.3"></SolidColorBrush>
                        </Grid.BorderBrush>
                        <TextBlock HorizontalAlignment="Center" Text="{x:Bind ViewModel.GetString('number_thread'), Mode=OneWay}"  Margin="0,25,0,0"></TextBlock>

                        <Slider   Margin="25,50,25,0" Minimum="1" ValueChanged="number_thread_ValueChanged" Value="{x:Bind ViewModel.SliderValue, Mode=TwoWay}" Maximum="10" Name="number_thread"></Slider>
                    </Grid>

                    <StackPanel Spacing="10" Width="300" HorizontalAlignment="Center" BorderThickness="2" CornerRadius="3">
                        <StackPanel.BorderBrush>
                            <SolidColorBrush Color="Gray" Opacity="0.3"></SolidColorBrush>
                        </StackPanel.BorderBrush>
                        <TextBlock HorizontalAlignment="Center" Text="{x:Bind ViewModel.GetString('type_setting'), Mode=OneWay}" Margin="0,25,0,0"></TextBlock>
                        <CheckBox Name="auto" CornerRadius="10" Margin="0,10,0,0" Checked="auto_Checked" Unchecked="auto_Unchecked" HorizontalAlignment="Center" Content="{x:Bind ViewModel.GetString('auto_setting_string'), Mode=OneWay}"></CheckBox>
                        <CheckBox Name="manual" CornerRadius="10" HorizontalAlignment="Center" Content="{x:Bind ViewModel.GetString('manual_setting_string'), Mode=OneWay}" Unchecked="manual_Unchecked" Checked="manual_Checked"></CheckBox>
                        <ScrollView Name="acc_scroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Visible">
                            <ListView SelectionMode="None" ItemsSource="{Binding Source={StaticResource automatic_list}}" Name="automatic_panel" Height="100" VerticalAlignment="Bottom"  Margin="25,10,25,20">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="50"   Tag="{Binding id}" HorizontalAlignment="Stretch" Name="folder">
                                            <SymbolIcon Symbol="Contact" HorizontalAlignment="Left" Margin="20,0,0,0" Foreground="#F4A232" VerticalAlignment="Center"></SymbolIcon>
                                            <TextBlock Margin="60,0,0,0" VerticalAlignment="Center" ></TextBlock>
                                            <Button Background="Transparent" Height="50" HorizontalAlignment="Stretch" CornerRadius="3"  >
                                                <Button.BorderBrush>
                                                    <SolidColorBrush Color="Gray" Opacity="0.3"></SolidColorBrush>
                                                </Button.BorderBrush>

                                            </Button>
                                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding name}"></TextBlock>
                                            <ToggleSwitch HorizontalAlignment="Right" OffContent="" OnContent="" IsOn="{Binding is_enabled}" Margin="0,0,-100,0" Toggled="account_toggle_switch_toggled"></ToggleSwitch>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                               


                            </ListView>
                        </ScrollView>
                        <ScrollView Name="manual_scroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Visible">
                            <ListView ItemContainerStyle="{StaticResource DraggableListViewItemStyle}" Height="100"  Name="manual_panel" ItemsSource="{Binding Source={StaticResource manual_list}}" CanDragItems="True" SelectionMode="None" CanReorderItems="True" AllowDrop="True" VerticalAlignment="Bottom"  Margin="25,10,25,20" DragItemsCompleted="manual_panel_DragItemsCompleted">
                                <ListView.ItemTemplate>
                                    <DataTemplate >
                                        <Grid Height="50"   Tag="{Binding id}" HorizontalAlignment="Stretch" Name="folder">
                                            <SymbolIcon Symbol="Contact" HorizontalAlignment="Left" Margin="20,0,0,0" Foreground="#F4A232" VerticalAlignment="Center"></SymbolIcon>
                                            <TextBlock Margin="60,0,0,0" VerticalAlignment="Center" ></TextBlock>
                                            <Button Background="Transparent" Height="50" HorizontalAlignment="Stretch" Name="manual_setting" Click="manual_setting_Click" CornerRadius="3"  >
                                                <Button.BorderBrush>
                                                    <SolidColorBrush Color="Gray" Opacity="0.3"></SolidColorBrush>
                                                </Button.BorderBrush>

                                            </Button>
                                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding name}"></TextBlock>
                                            <ToggleSwitch HorizontalAlignment="Right" OffContent="" OnContent="" IsOn="{Binding is_enabled}" Margin="0,0,-100,0" Toggled="manual_toggle_switch_toggled"></ToggleSwitch>
                                        </Grid>

                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollView>
                        <Button HorizontalAlignment="Center" Name="open_all_manual" Click="open_all_manual_Click">
                            <FontIcon Glyph="&#xE92D;"></FontIcon>
                        </Button>
                    </StackPanel>


                </StackPanel>
                <Frame Name="all_manual"></Frame>
                <Grid Height="150" Name="save_bar" VerticalAlignment="Bottom">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="save_transform" Y="90"/>
                    </Grid.RenderTransform>

                </Grid>
            </Grid>
        </Grid>
        
    </SplitView>
</Page>
