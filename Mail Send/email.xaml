<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Mail_Send.email"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mail_Send"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:views="using:Mail_Send.ViewModels"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.DataContext>
        <views:localizated x:Name="ViewModel" />
    </Page.DataContext>
    <Page.Resources>
        
        <CollectionViewSource x:Key="email_list"/>
    </Page.Resources>
    <Grid >
        <TextBlock Text="{x:Bind ViewModel.GetString('email_page'), Mode=OneWay}" Margin="25,40,0,0" FontSize="25" >
        </TextBlock>
        <StackPanel Spacing="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,25,0">
            <Button Name="import_file" Click="import_file_Click">
                <ToolTipService.ToolTip>
                    <ToolTip Content="{x:Bind ViewModel.GetString('import'), Mode=OneWay}"/>
                </ToolTipService.ToolTip>
                <FontIcon Glyph="&#xE752;"></FontIcon>
            </Button>
            <Button Name="export_file" Click="export_file_Click">
                <ToolTipService.ToolTip>
                    <ToolTip Content="{x:Bind ViewModel.GetString('export'), Mode=OneWay}"/>
                </ToolTipService.ToolTip>
                <FontIcon Glyph="&#xE896;"></FontIcon>
            </Button>
            <Button Click="past_email_open">
                <FontIcon Glyph="&#xE7AD;" Foreground="#F4A232"  ></FontIcon>
            </Button>
        </StackPanel>


        <ScrollView Margin="25,100,25,0">
            <ListView Name="email_listView" SelectionMode="None" AllowDrop="True" CanReorderItems="True" CanDragItems="True" DragItemsCompleted="email_listView_DragItemsCompleted" >
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Button RightTapped="open_email_content_RightTapped" Tag="{Binding id}" Width="200" HorizontalAlignment="Center" BorderThickness="1" Name="open_email_content" Click="open_email_content_Click" CornerRadius="5" Height="200">
                            <Grid >
                                <Grid.BorderBrush>
                                    <SolidColorBrush Color="Gray" Opacity="0.3"></SolidColorBrush>
                                </Grid.BorderBrush>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <SymbolIcon Margin="10,-160,0,0" Foreground="#F4A232" Symbol="List" ></SymbolIcon>
                                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Name="email_name" Margin="5,0,0,0" Text="{Binding name}"></TextBlock>
                                </StackPanel>

                                <Line Margin="0,30,0,0" Stroke="Gray" HorizontalAlignment="Center"
  X1="0" Y1="0"
  X2="300" Y2="0"
  StrokeThickness="1"/>
                                <Grid Margin="0,40,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" >
                                    <TextBlock TextWrapping="Wrap" Margin="20,0,20,0" Text="{Binding email}"></TextBlock>

                                    <Rectangle Height="90" Margin="0,40,0,0" RadiusX="5" RadiusY="5" VerticalAlignment="Bottom"  >
                                        <Rectangle.Fill>
                                            <media:AcrylicBrush  TintColor="White" TintOpacity="0.5" FallbackColor="White"/>
                                        </Rectangle.Fill>
                                    </Rectangle>

                                </Grid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ListView.ItemTemplate>

                <ListView.ItemsSource>
                    <Binding Source="{StaticResource email_list}"/>
                </ListView.ItemsSource>
            </ListView>
        </ScrollView>
        <TextBox PlaceholderText="{x:Bind ViewModel.GetString('add_email'), Mode=OneWay}" VerticalAlignment="Bottom" Height="50" Margin="20,5,20,20" PlaceholderForeground="Gray" Foreground="Black" Name="create_new_block" KeyDown="create_new_block_KeyDown"   CornerRadius="5"  TextChanged="create_new_block_TextChanged">
            <TextBox.BorderBrush>
                <SolidColorBrush Color="Black" Opacity="0.2"></SolidColorBrush>
            </TextBox.BorderBrush>
        </TextBox>
        <SplitView FlowDirection="RightToLeft" CornerRadius="10" Name="text_content"  HorizontalAlignment="Stretch"  >
            <SplitView.BorderBrush>
                <SolidColorBrush Color="Gray" Opacity="0.3"></SolidColorBrush>
            </SplitView.BorderBrush>
            <SplitView.Pane >
                <Grid Background="#FBFBFB">


                    <Frame FlowDirection="LeftToRight" Margin="0,0,0,0" Name="text_content_frame"></Frame>

                </Grid>
            </SplitView.Pane>
        </SplitView>
        <Grid Height="150" Name="save_bar" VerticalAlignment="Bottom">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="save_transform" Y="90"/>
            </Grid.RenderTransform>

        </Grid>
    </Grid>
</Page>
