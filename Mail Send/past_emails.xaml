<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Mail_Send.past_emails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mail_Send"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:views="using:Mail_Send.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.DataContext>
        <views:localizated x:Name="ViewModel" />
    </Page.DataContext>
    <Page.Resources>
    
        <CollectionViewSource x:Key="past_list"/>
    </Page.Resources>
    <Grid >
        <TextBlock Text="{x:Bind ViewModel.GetString('email_page'), Mode=OneWay}" Margin="25,40,0,0" FontSize="25" >
        </TextBlock>
        <StackPanel Name="folder_panel" Margin="25, 100, 25, 0"  Spacing="1" >
            <ItemsControl Name="folder_items" ItemsSource="{Binding Source={StaticResource past_list}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button RightTapped="open_email_content_RightTapped" Tag="{Binding id}" Width="200" HorizontalAlignment="Center" BorderThickness="1" Name="open_email_content" Click="open_email_content_Click" CornerRadius="5" Height="200">
                            <Grid >
                                <Grid.BorderBrush>
                                    <SolidColorBrush Color="Gray" Opacity="0.3"></SolidColorBrush>
                                </Grid.BorderBrush>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <SymbolIcon Margin="10,-160,0,0" Foreground="#F4A232" Symbol="List" ></SymbolIcon>
                                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Name="email_name" Margin="5,0,0,0" Text="{Binding name}"></TextBlock>
                                </StackPanel>

                                <Line Margin="0,30,0,0" Stroke="Gray" HorizontalAlignment="Center"
                                  X1="0" Y1="0"
                                  X2="300" Y2="0"
                                  StrokeThickness="1"/>
                                <Grid Margin="0,40,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" >
                                    <TextBlock TextWrapping="Wrap" Margin="20,0,20,0" Text="{Binding email}"></TextBlock>

                                    <Rectangle Height="90" Margin="0,40,0,0" RadiusX="5" RadiusY="5" VerticalAlignment="Bottom"  >
                                        <Rectangle.Fill>
                                            <media:AcrylicBrush  TintColor="White" TintOpacity="0.5" FallbackColor="White"/>
                                        </Rectangle.Fill>
                                    </Rectangle>

                                </Grid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>



        </StackPanel>
        <SplitView FlowDirection="RightToLeft" CornerRadius="10" Name="text_content"  HorizontalAlignment="Stretch"  >
            <SplitView.BorderBrush>
                <SolidColorBrush Color="Gray" Opacity="0.3"></SolidColorBrush>
            </SplitView.BorderBrush>
            <SplitView.Pane >
                <Grid Background="#FBFBFB">


                    <Frame FlowDirection="LeftToRight" Margin="0,0,0,0" Name="text_content_frame"></Frame>

                </Grid>
            </SplitView.Pane>
        </SplitView>
    </Grid>
</Page>
