<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Mail_Send.text_content"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mail_Send"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:views="using:Mail_Send.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.DataContext>
        <views:localizated x:Name="ViewModel" />
    </Page.DataContext>
    <Page.Resources>

        <CollectionViewSource x:Key="file_list"/>
    </Page.Resources>
    <StackPanel Orientation="Vertical" Spacing="10">

        <StackPanel Orientation="Horizontal" Spacing="20" >
            <FontIcon Glyph="&#xE8E5;"  FontSize="20" HorizontalAlignment="Left" Margin="20,0,0,0" Foreground="#F4A232"></FontIcon>
            <TextBox Name="topic_name" HorizontalAlignment="Stretch"  VerticalAlignment="Center" VerticalContentAlignment="Center" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Height="50" CornerRadius="2" BorderThickness="1" TextChanged="topic_name_TextChanged">

                <TextBox.BorderBrush>
                    <SolidColorBrush Color="Gray" Opacity="0"/>
                </TextBox.BorderBrush>
            </TextBox>
        </StackPanel>
        <Grid  Margin="20,0,20,0">
            <TextBox Name="text_textbox" PlaceholderText="Текст"  AcceptsReturn="True" TextWrapping="Wrap" HorizontalAlignment="Stretch"  VerticalAlignment="Top"  Height="200" CornerRadius="2" BorderThickness="1" TextChanged="text_textbox_TextChanged">

                <TextBox.BorderBrush>
                    <SolidColorBrush Color="Gray" Opacity="0.2"/>
                </TextBox.BorderBrush>
            </TextBox>
            

            <Button Name="generate_email_content" VerticalAlignment="Bottom" HorizontalAlignment="Right"  Click="generate_email_content_Click" Width="33" Height="33">

                <Button.Background>
                    <ImageBrush ImageSource="/Assets/star-06-svgrepo-com (2).svg" AlignmentX="Right" AlignmentY="Bottom" ></ImageBrush>
                </Button.Background>
            </Button>
            
        </Grid>

        <StackPanel Name="files_item"  Margin="20,0,20,0">
            <ItemsControl Name="files_items" ItemsSource="{Binding Source={StaticResource file_list}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="customGrid"  Tag="{Binding id}"  BorderThickness="1"   CornerRadius="2" Height="50">
                            <Grid.BorderBrush>
                                <SolidColorBrush Color="Gray" Opacity="0.3"></SolidColorBrush>
                            </Grid.BorderBrush>
                            <SymbolIcon Symbol="Page" HorizontalAlignment="Left" Foreground="Gray"  Margin="20,0,0,0"></SymbolIcon>

                            <TextBlock x:Name="fileNameTextBlock" Foreground="Gray" TextAlignment="Left" Text="{Binding name}" VerticalAlignment="Center"
   HorizontalAlignment="Left" Margin="60,0,112,10"/>
                            <TextBlock x:Name="weightFilesTextBlock" Foreground="Gray" Text="{Binding size}" TextAlignment="Left" VerticalAlignment="Center"
   HorizontalAlignment="Left" Margin="60,0,62,-20" />
                            <Button x:Name="button" IsTapEnabled="False" HorizontalAlignment="Right" Click="delete_file_Click"  Width="50" Height="50">
                                <Grid Width="25" Height="25" HorizontalAlignment="Center"
  VerticalAlignment="Center">
                                    <SymbolIcon Symbol="Cancel"></SymbolIcon>
                                </Grid>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            

        </StackPanel>
        <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="30" Margin="20,0,20,0">
                <FontIcon Glyph="&#xE8E5;"  FontSize="20" HorizontalAlignment="Left" Margin="20,0,0,0" Foreground="Gray"></FontIcon>
                <TextBlock Text="{x:Bind ViewModel.GetString('add_file'), Mode=OneWay}" TextAlignment="Center" VerticalAlignment="Center" >
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="Gray" Opacity="1"/>
                    </TextBlock.Foreground>

                </TextBlock>
            </StackPanel>
            <Button Background="Transparent" BorderThickness="1"  CornerRadius="2" Height="50" Margin="20,0,20,0" HorizontalAlignment="Stretch"  Click="add_new_file">
                <Button.BorderBrush>
                    <SolidColorBrush Color="Gray" Opacity="0.3"></SolidColorBrush>
                </Button.BorderBrush>
            </Button>
            
        </Grid>


    </StackPanel>
</Page>
